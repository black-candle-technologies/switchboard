{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/black-candle-technologies/switchboard.git"
  },
  "bugs": {
    "url": "https://github.com/black-candle-technologies/switchboard/issues"
  },
  "homepage": "https://github.com/black-candle-technologies/switchboard#readme",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test packages/cli/test/*.test.js",
    "example:install": "npm --prefix examples/basic-next-prisma install",
    "example:generate": "npm --prefix examples/basic-next-prisma run switchboard:init && npm --prefix examples/basic-next-prisma run switchboard:generate",
    "example:build": "npm --prefix examples/basic-next-prisma run build",
    "example:smoke": "node examples/basic-next-prisma/scripts/smoke.mjs",
    "db:migrate": "prisma migrate dev --name init --schema src/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema src/prisma/schema.prisma",
    "db:generate": "prisma generate --schema src/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "15.5.22",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lanebucher/switchboard": "^0.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
